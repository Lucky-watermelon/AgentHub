# 复制为 .env 后按需修改（.env 已在 .gitignore 中）
AH_PORT=8000
AH_HOST=127.0.0.1
AH_PROFILE=lite

# 数据库：留空使用 data/agenthub.db
# AH_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/agenthub

# 模型：true 时不出网，用规则化文本兜底
AH_LLM_MOCK=true

# 鉴权：对接业务系统时置为 true
AH_AUTH_REQUIRED=false

AH_DATA_DIR=data
AH_REPORTS_DIR=reports
